"""Inspect the raw Jena (MPI-BGC Beutenberg `mpi_roof`) ZIP files; stdlib only.

Reads CSV members straight out of the ZIPs as text (nothing in the download is
executed) and prints the statistics recorded in docs/dataset-card.md.

    python3 -I scripts/inspect_jena.py [data/raw/mpi_roof]
"""
import csv
import hashlib
import io
import math
import sys
import zipfile
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

RAW = Path(sys.argv[1] if len(sys.argv) > 1 else "data/raw/mpi_roof")
STEP = timedelta(minutes=10)
INPUT_H, TARGET_H = 72, 24
SENTINELS = {-9999.0}


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_zip(path):
    """Yield (header, rows) per CSV member; rows are lists of strings."""
    with zipfile.ZipFile(path) as z:
        for name in z.namelist():
            if name.endswith("/") or not name.lower().endswith((".csv", ".txt")):
                print(f"  NOTE non-CSV member ignored in {path.name}: {name}")
                continue
            text = io.TextIOWrapper(z.open(name), encoding="utf-8-sig", errors="replace", newline="")
            r = csv.reader(text)
            yield name, next(r), [row for row in r if row]


def main():
    files = sorted(RAW.glob("mpi_roof_*.zip"))
    print(f"files: {len(files)}")
    headers = Counter()
    records = []  # (ts, T or None, raw T string, file)
    bad_ts = 0
    per_file = []
    for p in files:
        n0 = len(records)
        for member, header, rows in read_zip(p):
            headers[tuple(header)] += 1
            ti = header.index("T (degC)")
            for row in rows:
                try:
                    ts = datetime.strptime(row[0].strip(), "%d.%m.%Y %H:%M")
                except ValueError:
                    bad_ts += 1
                    continue
                raw = row[ti].strip()
                try:
                    v = float(raw)
                except ValueError:
                    v = None
                records.append((ts, v, raw, p.name))
        per_file.append((p.name, sha256(p), len(records) - n0))
    print("distinct header layouts:", len(headers))
    for h, c in headers.items():
        print(f"  x{c}: {len(h)} cols; first 6: {h[:6]}")
    print("unparseable timestamps:", bad_ts)
    print("total rows:", len(records))
    print("per-file (name, sha256, rows):")
    for f in per_file:
        print("  ", *f)

    # order / duplicates (in file-concatenation order)
    nonmono = sum(1 for a, b in zip(records, records[1:]) if b[0] <= a[0])
    print("non-increasing steps in concatenated order:", nonmono)
    by_ts = {}
    dup_same = dup_conflict = 0
    for ts, v, raw, _ in records:
        if ts in by_ts:
            if by_ts[ts] == v:
                dup_same += 1
            else:
                dup_conflict += 1
        else:
            by_ts[ts] = v
    print(f"duplicate timestamps: identical={dup_same} conflicting={dup_conflict}")
    stamps = sorted(by_ts)
    print("timestamp range:", stamps[0], "->", stamps[-1], "unique:", len(stamps))
    print("minute values present:", sorted(Counter(t.minute for t in stamps)))

    # temperature validity
    missing = sum(1 for v in by_ts.values() if v is None)
    nonfinite = sum(1 for v in by_ts.values() if v is not None and not math.isfinite(v))
    sent = sum(1 for v in by_ts.values() if v in SENTINELS)
    good = [v for v in by_ts.values() if v is not None and math.isfinite(v) and v not in SENTINELS]
    print(f"T unparseable={missing} nonfinite={nonfinite} sentinel(-9999)={sent}")
    print(f"T finite range: {min(good):.2f} .. {max(good):.2f}; n={len(good)}")
    print("T < -40 or > 45:", sum(1 for v in good if v < -40 or v > 45))
    # also report other negative sentinels
    print("T values <= -90:", sorted(Counter(v for v in good if v <= -90).items())[:5])

    # gaps on the 10-minute grid
    gaps = Counter()
    gap_list = []
    for a, b in zip(stamps, stamps[1:]):
        d = b - a
        if d != STEP:
            gaps[d] += 1
            gap_list.append((a, b, d))
    print("non-10-minute steps:", sum(gaps.values()))
    print("most common gap sizes:", [(str(k), c) for k, c in gaps.most_common(8)])
    print("largest gaps:")
    for a, b, d in sorted(gap_list, key=lambda g: g[2], reverse=True)[:8]:
        print("  ", a, "->", b, d)
    grid_expected = int((stamps[-1] - stamps[0]) / STEP) + 1
    print(f"10-min grid slots {grid_expected}, present {len(stamps)}, absent {grid_expected - len(stamps)}")

    # daylight-saving evidence: do 02:xx slots exist/duplicate around DST changes?
    print("DST probe (per year, last Sunday of Mar/Oct, count of 02:00-02:50 stamps):")
    for y in range(stamps[0].year, stamps[-1].year + 1):
        def last_sun(m):
            d = datetime(y, m + 1, 1) - timedelta(days=1) if m < 12 else datetime(y, 12, 31)
            while d.weekday() != 6:
                d -= timedelta(days=1)
            return d.date()
        out = []
        for m in (3, 10):
            day = last_sun(m)
            out.append(sum(1 for t in stamps if t.date() == day and t.hour == 2))
        print("  ", y, "Mar:", out[0], "Oct:", out[1])

    # hourly rule: hour label H:00 = mean of the six 10-min records stamped
    # H-0:50, H-0:40, ..., H:00 (the timestamp is the END of each averaging period)
    valid = {}
    first_h = (stamps[0] + timedelta(minutes=59)).replace(minute=0, second=0)
    last_h = stamps[-1].replace(minute=0, second=0)
    h = first_h
    total_hours = incomplete = 0
    while h <= last_h:
        total_hours += 1
        vals = [by_ts.get(h - timedelta(minutes=10 * k)) for k in range(6)]
        if all(v is not None and math.isfinite(v) and v not in SENTINELS for v in vals):
            valid[h] = sum(vals) / 6
        else:
            incomplete += 1
        h += timedelta(hours=1)
    print(f"hourly grid {first_h} -> {last_h}: {total_hours} hours; complete(6/6)={len(valid)}; invalid={incomplete}")

    # chronological 70/15/15 split on the calendar-hour grid
    n = total_hours
    b1, b2 = int(n * 0.70), int(n * 0.85)
    t0 = first_h
    def at(i):
        return t0 + timedelta(hours=i)
    parts = {"train": (0, b1), "validation": (b1, b2), "test": (b2, n)}
    print("split boundaries (hour index ranges [start, end) on the grid):")
    need = INPUT_H + TARGET_H
    for name, (a, b) in parts.items():
        vh = sum(1 for i in range(a, b) if at(i) in valid)
        # windows: maximal runs of consecutive valid hours inside [a, b)
        windows, run, longest = 0, 0, 0
        for i in range(a, b):
            if at(i) in valid:
                run += 1
            else:
                windows += max(0, run - need + 1)
                longest = max(longest, run)
                run = 0
        windows += max(0, run - need + 1)
        longest = max(longest, run)
        print(f"  {name}: {at(a)} .. {at(b - 1)}  grid_hours={b - a} valid_hours={vh} "
              f"windows(stride1,{INPUT_H}->{TARGET_H})={windows} longest_run={longest}")


main()
