"""FastAPI model service -- Cloud #2 (deployed on Render.com).

Responsibilities:
  * expose the attention classifier behind HTTP so the Streamlit UI can call it
    over HTTPS,
  * read dataset parameters from Supabase before training,
  * write run rows, model artifacts, and sequence metadata (hash only) back.

There is NO UI code here and NO business logic in the UI -- separation of
concerns across the three clouds. This is "Attend-It": sequence classification
with an LSTM + additive (Bahdanau) attention that returns per-timestep
attention weights so a client can see *which token* the model relied on.
"""
from __future__ import annotations

import hashlib
import json
import os
import subprocess

import torch
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware

from api import db
from api.training import predict_seq, train_attention
from shared.data import CLASS_NAMES, N_CLASSES, VOCAB_SIZE, generate_one
from shared.schemas import (
    ClassesResponse,
    ClassMetrics,
    Dataset,
    DatasetCreate,
    Health,
    PredictRequest,
    PredictResponse,
    PredictSampleRequest,
    Run,
    TrainRequest,
    TrainResponse,
    Version,
)

app = FastAPI(
    title="Attend-It API",
    description="LSTM + attention sequence classifier for the three-cloud stack.",
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=os.environ.get("ALLOWED_ORIGINS", "*").split(","),
    allow_methods=["*"],
    allow_headers=["*"],
)


def _git_sha() -> str:
    if os.environ.get("RENDER_GIT_COMMIT"):
        return os.environ["RENDER_GIT_COMMIT"][:7]
    try:
        return (
            subprocess.check_output(["git", "rev-parse", "--short", "HEAD"])
            .decode()
            .strip()
        )
    except Exception:
        return "unknown"


def _project_ref() -> str | None:
    url = os.environ.get("SUPABASE_URL", "")
    if url.startswith("https://"):
        return url.split("//", 1)[1].split(".", 1)[0]
    return None


def _artifact_or_404(run_id: int) -> str:
    model_b64 = db.get_run_artifact(run_id)
    if model_b64 is None:
        raise HTTPException(status_code=404, detail="run_id not found")
    return model_b64


def _seq_sha256(sequence: list[int]) -> str:
    """Stable hash of the token sequence (no raw tokens are ever stored)."""
    return hashlib.sha256(json.dumps(sequence).encode()).hexdigest()


# ---------------------------------------------------------------------------
# datasets
# ---------------------------------------------------------------------------
@app.post("/datasets", response_model=Dataset, tags=["datasets"])
def create_dataset(req: DatasetCreate) -> Dataset:
    """Register a synthetic sequence dataset (parameters only; tokens come from seed)."""
    row = db.insert_dataset(
        name=req.name,
        n_rows=req.n_rows,
        seq_len=req.seq_len,
        vocab_size=VOCAB_SIZE,
        n_classes=N_CLASSES,
        seed=req.seed,
    )
    return Dataset(**{k: row[k] for k in Dataset.model_fields})


# ---------------------------------------------------------------------------
# training
# ---------------------------------------------------------------------------
@app.post("/train", response_model=TrainResponse, tags=["training"])
def train(req: TrainRequest) -> TrainResponse:
    """Read dataset params from Supabase, train the model, persist run + artifact."""
    dataset = db.get_dataset(req.dataset_id)
    if dataset is None:
        raise HTTPException(status_code=404, detail="dataset_id not found")

    metrics, model_b64, _loss = train_attention(
        n_rows=dataset["n_rows"],
        seq_len=dataset["seq_len"],
        seed=dataset["seed"],
        lr=req.lr,
        batch_size=req.batch_size,
        epochs=req.epochs,
        test_size=req.test_size,
    )
    run = db.insert_run(
        dataset_id=req.dataset_id,
        lr=req.lr,
        batch_size=req.batch_size,
        epochs=req.epochs,
        metrics=metrics,
        model_b64=model_b64,
    )
    return TrainResponse(run_id=run["id"], metrics=ClassMetrics(**metrics))


@app.get("/runs/{run_id}", response_model=Run, tags=["training"])
def get_run(run_id: int) -> Run:
    row = db.get_run(run_id)
    if row is None:
        raise HTTPException(status_code=404, detail="run_id not found")
    return Run(**{k: row[k] for k in Run.model_fields})


@app.get("/runs", response_model=list[Run], tags=["training"])
def list_runs() -> list[Run]:
    rows = db.latest_runs(limit=50)
    return [Run(**{k: r[k] for k in Run.model_fields}) for r in rows]


# ---------------------------------------------------------------------------
# prediction  (attention explainability)
# ---------------------------------------------------------------------------
def _predict_sequence(
    run_id: int, sequence: list[int], true_class: str | None
) -> PredictResponse:
    model_b64 = _artifact_or_404(run_id)
    result = predict_seq(model_b64, sequence)
    sha256 = _seq_sha256(sequence)
    db.insert_sequence_metadata(
        run_id=run_id,
        sha256=sha256,
        length=len(sequence),
        label=result["label"],
        class_name=result["class_name"],
        confidence=result["confidence"],
    )
    return PredictResponse(
        run_id=run_id,
        sequence=sequence,
        sequence_sha256=sha256,
        true_class=true_class,
        **result,
    )


@app.post("/predict", response_model=PredictResponse, tags=["prediction"])
def predict(req: PredictRequest) -> PredictResponse:
    """Classify a token sequence and return per-timestep attention weights.

    Only the sequence's sha256 hash + length + prediction are logged -- never
    the raw tokens.
    """
    if any(t < 0 or t >= VOCAB_SIZE for t in req.sequence):
        raise HTTPException(
            status_code=422, detail=f"token ids must be in [0, {VOCAB_SIZE})"
        )
    return _predict_sequence(req.run_id, req.sequence, true_class=None)


@app.post("/predict_sample", response_model=PredictResponse, tags=["prediction"])
def predict_sample(req: PredictSampleRequest) -> PredictResponse:
    """Generate a synthetic sequence, classify it, and return attention weights.

    Lets the UI demonstrate the model without the user typing a token sequence.
    """
    kind = (
        req.true_class
        if (req.true_class is None or req.true_class < N_CLASSES)
        else None
    )
    seq, label, _pos = generate_one(seed=req.seed, kind=kind)
    return _predict_sequence(
        req.run_id, [int(t) for t in seq], true_class=CLASS_NAMES[label]
    )


# ---------------------------------------------------------------------------
# meta
# ---------------------------------------------------------------------------
@app.get("/classes", response_model=ClassesResponse, tags=["meta"])
def classes() -> ClassesResponse:
    """Return the class labels the model predicts over."""
    return ClassesResponse(classes=CLASS_NAMES, n_classes=N_CLASSES)


# ---------------------------------------------------------------------------
# ops
# ---------------------------------------------------------------------------
@app.get("/healthz", response_model=Health, tags=["ops"])
def healthz() -> Health:
    supabase_ok = db.ping()
    model_ok = torch.tensor([1.0]).sum().item() == 1.0
    status = "ok" if (supabase_ok and model_ok) else "degraded"
    return Health(status=status, model_loader=model_ok, supabase=supabase_ok)


@app.get("/version", response_model=Version, tags=["ops"])
def version() -> Version:
    return Version(
        git_sha=_git_sha(),
        torch_version=torch.__version__,
        supabase_project_ref=_project_ref(),
    )
"""Supabase persistence helpers for the API tier.

All Supabase access for the model service is funneled through this module. The
FastAPI app calls these functions; it never talks to Supabase directly. The
Streamlit UI NEVER imports this module -- it does its one read-only query with
the anon key on its own side.

We store an input sequence's **sha256 hash and length** in `sequence_metadata`,
never the raw tokens (the "store hashes, not raw payloads" invariant). The
fitted attention model lives in `run_artifacts` (not anon-readable).

Environment variables (set locally in a .env, and in the Render dashboard):
    SUPABASE_URL              -> https://<project-ref>.supabase.co
    SUPABASE_SERVICE_KEY      -> the service-role key (server-side only, secret!)
"""
from __future__ import annotations

import os
from typing import List, Optional

from supabase import Client, create_client

_client: Optional[Client] = None

_RUN_COLS = "id,dataset_id,lr,batch_size,epochs,accuracy,macro_f1,created_at"


def get_client() -> Client:
    """Lazily create and cache a Supabase client."""
    global _client
    if _client is None:
        url = os.environ["SUPABASE_URL"]
        key = os.environ["SUPABASE_SERVICE_KEY"]
        _client = create_client(url, key)
    return _client


def ping() -> bool:
    try:
        get_client().table("datasets").select("id").limit(1).execute()
        return True
    except Exception:
        return False


# ---------------------------------------------------------------------------
# datasets  (only the generation parameters -- sequences are regenerated by seed)
# ---------------------------------------------------------------------------
def insert_dataset(
    name: str, n_rows: int, seq_len: int, vocab_size: int, n_classes: int, seed: int
) -> dict:
    resp = (
        get_client()
        .table("datasets")
        .insert(
            {
                "name": name,
                "n_rows": n_rows,
                "seq_len": seq_len,
                "vocab_size": vocab_size,
                "n_classes": n_classes,
                "seed": seed,
            }
        )
        .execute()
    )
    return resp.data[0]


def get_dataset(dataset_id: int) -> Optional[dict]:
    resp = (
        get_client()
        .table("datasets")
        .select("*")
        .eq("id", dataset_id)
        .limit(1)
        .execute()
    )
    return resp.data[0] if resp.data else None


# ---------------------------------------------------------------------------
# runs  +  run_artifacts
# ---------------------------------------------------------------------------
def insert_run(
    dataset_id: int,
    lr: float,
    batch_size: int,
    epochs: int,
    metrics: dict,
    model_b64: str,
) -> dict:
    client = get_client()
    resp = (
        client.table("runs")
        .insert(
            {
                "dataset_id": dataset_id,
                "lr": lr,
                "batch_size": batch_size,
                "epochs": epochs,
                "accuracy": metrics["accuracy"],
                "macro_f1": metrics["macro_f1"],
            }
        )
        .execute()
    )
    run = resp.data[0]
    client.table("run_artifacts").insert(
        {"run_id": run["id"], "model_b64": model_b64}
    ).execute()
    return run


def get_run(run_id: int) -> Optional[dict]:
    resp = (
        get_client().table("runs").select(_RUN_COLS).eq("id", run_id).limit(1).execute()
    )
    return resp.data[0] if resp.data else None


def get_run_artifact(run_id: int) -> Optional[str]:
    resp = (
        get_client()
        .table("run_artifacts")
        .select("model_b64")
        .eq("run_id", run_id)
        .limit(1)
        .execute()
    )
    return resp.data[0]["model_b64"] if resp.data else None


def latest_runs(limit: int = 50) -> List[dict]:
    resp = (
        get_client()
        .table("runs")
        .select(_RUN_COLS)
        .order("created_at", desc=True)
        .limit(limit)
        .execute()
    )
    return resp.data


# ---------------------------------------------------------------------------
# sequence_metadata  (hash + length + prediction; NO raw tokens)
# ---------------------------------------------------------------------------
def insert_sequence_metadata(
    run_id: int,
    sha256: str,
    length: int,
    label: int,
    class_name: str,
    confidence: float,
) -> dict:
    resp = (
        get_client()
        .table("sequence_metadata")
        .insert(
            {
                "run_id": run_id,
                "sha256": sha256,
                "length": length,
                "label": label,
                "class_name": class_name,
                "confidence": confidence,
            }
        )
        .execute()
    )
    return resp.data[0]
"""Read one data version of the Jena corpus from Supabase (read-only).

Kept apart from the pure preprocessing in ``shared/forecasting.py``. The client
is injected, so this module imports no database library and tests can pass a
mock. It uses only ``table().select().eq().order().range().execute()``, which the
pinned supabase-py (2.7.4, see api/requirements.txt) supports.
"""
from __future__ import annotations

from typing import Iterator, List

import numpy as np

from shared.forecasting import ForecastDataError, ForecastingData, prepare_forecasting_data

TABLE = "sequences"
COLUMNS = "station_ts,temperature_c,split,data_version"
# PostgREST caps a response at 1000 rows by default (Supabase "Max rows"), so a
# larger page would be silently truncated and look like the last page.
MAX_PAGE = 1000


def fetch_corpus_rows(client, data_version: str, page_size: int = MAX_PAGE) -> Iterator[dict]:
    """Yield every stored row of ``data_version``, ordered by ``station_ts``.

    Pages with an explicit column list and a deterministic order
    (``station_ts`` is unique within a data version). Stops at the first short
    page, or an empty one when the row count is an exact multiple of the page size.
    """
    if not isinstance(data_version, str) or not data_version:
        raise ForecastDataError("data_version must be a non-empty string")
    if not 1 <= page_size <= MAX_PAGE:
        raise ForecastDataError(f"page_size must be between 1 and {MAX_PAGE}")
    start = 0
    while True:
        rows: List[dict] = (client.table(TABLE).select(COLUMNS)
                            .eq("data_version", data_version).order("station_ts")
                            .range(start, start + page_size - 1).execute().data)
        yield from rows
        if len(rows) < page_size:
            return
        start += page_size


def load_forecasting_data(client, data_version: str, page_size: int = MAX_PAGE,
                          dtype=np.float32) -> ForecastingData:
    """Fetch ``data_version`` and prepare scaled windows for all splits."""
    return prepare_forecasting_data(fetch_corpus_rows(client, data_version, page_size),
                                    expected_data_version=data_version, dtype=dtype)
"""Seq Sight forecasting models: an LSTM baseline and a self-attention model.

Both map a standardized history ``[batch, 72, 1]`` (float32) to a standardized
24 h forecast ``[batch, 24]`` and share one return contract::

    forecast, attention = model(x)
    # LSTMForecaster:      attention is None (it has no attention weights)
    # AttentionForecaster: attention is [batch, 72, 72]

Only the 72 known historical hours enter either model; no target value is an
input. Full (non-causal) attention over the history is therefore legitimate.

IMPORTANT - what the attention matrix means. ``attention[b, i, j]`` says how much
the contextualized representation of input hour *i* draws on input hour *j*
(rows sum to 1 over j). It describes INPUT-TO-INPUT relationships inside the
encoder. It is NOT an attribution of any one of the 24 output hours to input
hours: the forecast head reads pooled representations, so no output hour has its
own attention row. Describe it as "where the encoder's attention weights were",
not as "why hour t+k was predicted".

Architectures (kept small for local CPU training)
-------------------------------------------------
LSTMForecaster: LSTM(1 -> hidden, 1 layer) -> final hidden state -> ForecastHead.

AttentionForecaster:
    Linear(1 -> d_model)                      input projection
    + sinusoidal positional encoding          fixed, not learned
    single-head scaled dot-product self-attention (hand-written):
        Q = X Wq, K = X Wk, V = X Wv
        A = softmax(Q K^T / sqrt(d_k), over keys);  C = A V
    H = LayerNorm(X + C)                      residual keeps each hour's own signal
    pooling = concat[ H[:, -1], mean_t H ]    -> [batch, 2 * d_model]
    ForecastHead

Pooling: after attention, every row H[:, t] is a contextualized representation of
hour t that has mixed in information from all 72 hours. The last row (most recent
hour, which the next 24 hours directly follow) is the natural summary of "where
the series is now in the context of its history"; the mean row is an order-free
summary of the whole window. Concatenating both and mapping them with the head to
all 24 outputs at once (direct multi-horizon, no autoregressive feedback) gives
the head both the current state and the window-wide context. Pooling discards
which input hour contributed what, which is why the attention matrix cannot be
read as per-output attribution.

ForecastHead: Linear(in -> head_hidden) -> ReLU -> Linear(head_hidden -> 24). The
layer PATTERN and head_hidden match in both models, but the input width differs
(hidden_size = 32 for the LSTM, 2 * d_model = 64 for attention), so the first head
layer has different weights/parameters. The encoders differ as well.

Equal parameter counts do NOT mean equal compute: attention costs O(T^2) in the
sequence length and parallelizes over time, while the LSTM is O(T) but sequential.
Compare measured training time, not just parameter counts.
"""
from __future__ import annotations

import math
from typing import Any, Dict, Optional, Tuple

import torch
from torch import nn

INPUT_HOURS = 72
TARGET_HOURS = 24
MODEL_TYPES = ("lstm", "attention")  # matches runs.model_type in the database


def _check_input(x: torch.Tensor) -> None:
    if x.ndim != 3 or tuple(x.shape[1:]) != (INPUT_HOURS, 1):
        raise ValueError(f"expected input [batch, {INPUT_HOURS}, 1], got {tuple(x.shape)}")
    if x.dtype != torch.float32:
        raise ValueError(f"expected float32 input, got {x.dtype}")


def sinusoidal_positional_encoding(length: int, d_model: int) -> torch.Tensor:
    """``[length, d_model]``: PE[p, 2i] = sin(p / 10000^(2i/d)), PE[p, 2i+1] = cos(...)."""
    if d_model % 2:
        raise ValueError("d_model must be even for sinusoidal positional encoding")
    pos = torch.arange(length, dtype=torch.float64).unsqueeze(1)
    freq = torch.exp(torch.arange(0, d_model, 2, dtype=torch.float64) * (-math.log(10000.0) / d_model))
    pe = torch.zeros(length, d_model, dtype=torch.float64)
    pe[:, 0::2] = torch.sin(pos * freq)
    pe[:, 1::2] = torch.cos(pos * freq)
    return pe.float()


def scaled_dot_product_attention(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor
                                 ) -> Tuple[torch.Tensor, torch.Tensor]:
    """softmax(q k^T / sqrt(d_k)) v for ``[..., T, d]`` tensors; returns (output, weights)."""
    d_k = q.shape[-1]
    scores = torch.matmul(q, k.transpose(-2, -1)) / math.sqrt(d_k)  # [..., T_q, T_k]
    weights = torch.softmax(scores, dim=-1)                          # over keys
    return torch.matmul(weights, v), weights


class ForecastHead(nn.Module):
    def __init__(self, in_features: int, hidden: int):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(in_features, hidden), nn.ReLU(), nn.Linear(hidden, TARGET_HOURS))

    def forward(self, z: torch.Tensor) -> torch.Tensor:
        return self.net(z)


class LSTMForecaster(nn.Module):
    """Single-layer LSTM baseline. Returns ``(forecast [B, 24], None)``."""

    def __init__(self, hidden_size: int = 32, head_hidden: int = 64):
        super().__init__()
        self.hidden_size, self.head_hidden = hidden_size, head_hidden
        self.lstm = nn.LSTM(input_size=1, hidden_size=hidden_size, num_layers=1, batch_first=True)
        self.head = ForecastHead(hidden_size, head_hidden)

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, None]:
        _check_input(x)
        _, (h_n, _) = self.lstm(x)           # h_n: [1, B, hidden] = state after the 72nd hour
        return self.head(h_n[-1]), None

    def config(self) -> Dict[str, Any]:
        return {"model_type": "lstm", "hidden_size": self.hidden_size, "head_hidden": self.head_hidden}


class AttentionForecaster(nn.Module):
    """Single-head self-attention encoder. Returns ``(forecast [B, 24], weights [B, 72, 72])``."""

    def __init__(self, d_model: int = 32, head_hidden: int = 64):
        super().__init__()
        self.d_model, self.head_hidden = d_model, head_hidden
        self.input_proj = nn.Linear(1, d_model)
        self.register_buffer("pos_enc", sinusoidal_positional_encoding(INPUT_HOURS, d_model), persistent=False)
        self.w_q = nn.Linear(d_model, d_model)
        self.w_k = nn.Linear(d_model, d_model)
        self.w_v = nn.Linear(d_model, d_model)
        self.norm = nn.LayerNorm(d_model)
        self.head = ForecastHead(2 * d_model, head_hidden)

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        _check_input(x)
        h = self.input_proj(x) + self.pos_enc                        # [B, 72, d]
        context, weights = scaled_dot_product_attention(self.w_q(h), self.w_k(h), self.w_v(h))
        h = self.norm(h + context)                                   # [B, 72, d] contextualized
        pooled = torch.cat([h[:, -1], h.mean(dim=1)], dim=-1)        # [B, 2d]
        return self.head(pooled), weights

    def config(self) -> Dict[str, Any]:
        return {"model_type": "attention", "d_model": self.d_model, "head_hidden": self.head_hidden}


def build_model(model_type: str, **kwargs) -> nn.Module:
    if model_type == "lstm":
        return LSTMForecaster(**kwargs)
    if model_type == "attention":
        return AttentionForecaster(**kwargs)
    raise ValueError(f"unknown model_type {model_type!r}; expected one of {MODEL_TYPES}")


def count_parameters(model: nn.Module) -> int:
    """Trainable parameters (the fixed positional encoding is a buffer, not counted)."""
    return sum(p.numel() for p in model.parameters() if p.requires_grad)
