def read_manifest(path: Path) -> Dict[str, dict]:
    """{filename: {"sha256": str, "rows": int}} from the checksum manifest."""
    out: Dict[str, dict] = {}
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
