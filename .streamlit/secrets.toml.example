# Streamlit reads secrets from .streamlit/secrets.toml in the directory you launch from
# (the repository root):   .venv312/bin/python -m streamlit run ui/app.py
# Copy this file to .streamlit/secrets.toml and fill it in; also paste the same keys
# into the Streamlit Community Cloud "Secrets" box when deploying.
# NEVER commit the real secrets.toml (it is git-ignored). Placeholders only below.

API_URL = "https://your-service.onrender.com"
SUPABASE_URL = "https://your-project-ref.supabase.co"
# The PUBLIC anon key only (RLS limits it to SELECT on runs and predictions).
# NEVER put the service-role / secret key here; the UI refuses detectable ones.
SUPABASE_ANON_KEY = "your-anon-key"
