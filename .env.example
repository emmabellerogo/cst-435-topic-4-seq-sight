# Backend (FastAPI) environment. Copy to .env for local use; set the same
# names in the Render dashboard. Placeholders only: never commit real values.
# .env is git-ignored.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key: SERVER-SIDE ONLY. Bypasses RLS. Never put it in the UI,
# in secrets.toml, or in any client-visible place.
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated allowed CORS origins; tighten from "*" once the UI URL is known.
ALLOWED_ORIGINS=*

# Forecasting API (see docs/forecasting-api.md). Run ids come from the registration
# command; there is no default, and an unregistered model is never served.
FORECAST_LSTM_RUN_ID=
FORECAST_ATTENTION_RUN_ID=
# Optional artifact paths (defaults: artifacts/epoch50/final/*_seed0.pt, a development default)
# FORECAST_LSTM_ARTIFACT=
# FORECAST_ATTENTION_ARTIFACT=
