# Backend (FastAPI) environment. Copy to .env for local use; set the same
# names in the Render dashboard. Placeholders only: never commit real values.
# .env is git-ignored.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key: SERVER-SIDE ONLY. Bypasses RLS. Never put it in the UI,
# in secrets.toml, or in any client-visible place.
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated allowed CORS origins; tighten from "*" once the UI URL is known.
ALLOWED_ORIGINS=*
